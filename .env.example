# Copy to .env.local and fill in. Never commit .env.local.

# AI extraction: "gemini" (default) or "claude". Only redacted text is ever sent.
EXTRACT_PROVIDER=gemini
# Gemini: free key from Google AI Studio. Free-tier data may be used by Google to improve products.
GEMINI_API_KEY=
# Optional override; default gemini-3.5-flash-lite (fast; its own free quota)
GEMINI_MODEL=
# Claude: only needed when EXTRACT_PROVIDER=claude (needs API credits)
ANTHROPIC_API_KEY=

# Mail: PostGrid TEST key (starts with test_). The app refuses any other key.
POSTGRID_API_KEY=test_xxx
# Supabase: Project Settings → API Keys (secret key) and Data API (project URL).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supabase publishable key (Project Settings → API Keys → Publishable key, sb_publishable_…).
# Used server-side for sign-in sessions; it carries only the signed-in user's rights.
SUPABASE_PUBLISHABLE_KEY=
